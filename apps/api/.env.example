DATABASE_URL=postgres://uddokta@localhost:5433/uddokta
# Production media storage (Cloudflare R2). Leave unset in development: files go to .media/ instead.
# R2_ACCOUNT_ID=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# MEDIA_PUBLIC_URL=https://media.example.com

# Development: images missing from .media/ (rows from npm run db:pull-live) load from the live bucket.
LIVE_MEDIA_URL=https://media.uddokta.live

# Phone verification SMS through Alpha SMS (sms.net.bd panel › API). Unset in development: SMS go to .sms/ instead.
# SMS_API_KEY=
# SMS_SENDER_ID=
