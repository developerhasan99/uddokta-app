{
  "name": "console",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5174 & node --watch --env-file=../api/.env server/index.ts & wait",
    "start": "node server/index.ts",
    "build": "tsc --noEmit -p tsconfig.server.json && tsc --noEmit && vite build",
    "admin": "node --env-file-if-exists=../api/.env server/console-admin.ts",
    "test": "DATABASE_URL=postgres://uddokta@localhost:5433/uddokta_test MEDIA_DIR=/tmp/uddokta-test-media EMAIL_DIR=/tmp/uddokta-test-emails node --test --test-concurrency=1 server/*.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/noto-sans-bengali": "5.3.0",
    "@hono/node-server": "2.1.5",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.16",
    "lucide-react": "1.66.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
