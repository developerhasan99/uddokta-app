# Sellers' own domains. Every domain gets a certificate on its first visit, but only after the storefront
# says it belongs to a store (seller domains and their www).
{
	on_demand_tls {
		ask https://domains.uddokta.live/_domains/allowed
	}
}

https:// {
	tls {
		on_demand
	}
	# Railway routes by Host, and *.uddokta.live already reaches the storefront; it reads the buyer's host from X-Store-Host.
	reverse_proxy https://domains.uddokta.live {
		header_up Host domains.uddokta.live
		header_up X-Forwarded-Host domains.uddokta.live
		header_up X-Store-Host {host}
	}
}

http:// {
	redir https://{host}{uri} 308
}
