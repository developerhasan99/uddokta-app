# Add these values to Railway's service variables. Never commit real credentials.
NODE_ENV=production
# Storefront only: set ROBOTS_NOINDEX=true on a test environment to keep search engines out. Leave it unset in production.
STOREFRONT_DOMAIN=uddokta.live
VITE_STOREFRONT_DOMAIN=uddokta.live
# Reference Railway Postgres's private URL in both application services.
DATABASE_URL=
R2_ACCOUNT_ID=
R2_BUCKET=uddokta-beta-media
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
MEDIA_PUBLIC_URL=https://media.uddokta.live
# API only: generate a random key of at least 32 characters and retain it across deployments.
COURIER_KEY=
# API only: anyone can sign up. Use allowlist (with SIGNUP_EMAIL_ALLOWLIST=a@x.com,b@y.com) or closed to restrict it.
SIGNUP_MODE=open
# API only: the domains proxy's fixed IPv4 (deploy/proxy on Fly.io). Sellers point their own domains here.
DOMAINS_IP=37.16.26.111
